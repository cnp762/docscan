# DocScan — public template only. Copy to .env and fill real values.
# Never commit .env or key files.

# --- Brand / URLs ---
PUBLIC_SITE_URL=https://docscan.cam
API_BASE_URL=https://api.docscan.cam/v1
API_BASE_URL_PROD=https://api.docscan.cam/v1
API_BASE_URL_DEV=https://desktop-d5brjmr.tail79d3ce.ts.net:3005/v1

# --- Cloudflare Pages (LDP) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_PAGES_PROJECT=docscan

# --- Server ---
DATABASE_URL=postgresql+asyncpg://docscan:docscan@localhost:5432/docscan
JWT_SECRET=change-me
CLOUDFLARE_TUNNEL_TOKEN=

# Apple App Store Server API / IAP
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXX.p8
APPLE_BUNDLE_ID=cam.docscan

# Google Play
GOOGLE_PLAY_PACKAGE_NAME=cam.docscan
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=./secrets/play-service-account.json

# Mobile product IDs (StoreKit / Play Billing)
PRODUCT_PRO_MONTHLY=pro_monthly
PRODUCT_PRO_QUARTERLY=pro_quarterly
PRODUCT_PRO_YEARLY=pro_yearly

# Google OAuth (Drive / Photos) — client IDs only in example; secrets stay local
GOOGLE_OAUTH_CLIENT_ID_ANDROID=
GOOGLE_OAUTH_CLIENT_ID_IOS=
GOOGLE_OAUTH_REVERSED_CLIENT_ID_IOS=
GOOGLE_OAUTH_CLIENT_ID_WEB=

# --- Mobile Ads (AdMob) ---
# Google-published test IDs for local dev; replace with production IDs in .env
ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
ADMOB_BANNER_UNIT_ID_ANDROID=ca-app-pub-3940256099942544/6300978111
ADMOB_APP_ID_IOS=ca-app-pub-3940256099942544~1458002511
ADMOB_BANNER_UNIT_ID_IOS=ca-app-pub-3940256099942544/2934735716
