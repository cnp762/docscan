---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Terms of Use — DocScan">
  <main class="doc">
    <p><a href="/">← DocScan</a></p>
    <h1>Terms of Use</h1>
    <p>Last updated: 2026-03-26</p>
    <p>By using DocScan you agree to these terms. The app is provided for digitizing documents you are authorized to scan.</p>
    <h2>Subscriptions</h2>
    <p>Paid plans are billed through the App Store or Google Play. Prices: Pro $1/month, $2/3 months, $6/year. Free tier includes 5 page commits per UTC day.</p>
    <h2>Acceptable use</h2>
    <p>Do not use DocScan to infringe others’ rights or violate law. You are responsible for content you scan, export, or back up.</p>
    <h2>Contact</h2>
    <p>legal@docscan.cam</p>
  </main>
</BaseLayout>
<style>
  .doc { max-width: 40rem; margin: 0 auto; padding: 2rem 1.5rem 4rem; line-height: 1.6; color: var(--muted); }
  h1, h2 { color: var(--ink); font-family: var(--font-display); font-weight: 400; }
  a { color: var(--accent); }
</style>
